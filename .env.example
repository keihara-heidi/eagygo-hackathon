# Create a KICK app at https://kick.com/settings/developer and register
# http://localhost:3000/api/auth/callback as its redirect URL.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Supabase Postgres (pooler URL) — used by Drizzle
DATABASE_URL=

# ElevenLabs (voice agent wildcard)
ELEVENLABS_API_KEY=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
