# Create a KICK app at https://kick.com/settings/developer and register
# http://localhost:3000/api/auth/callback as its redirect URL.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Supabase Postgres (pooler URL) — used by Drizzle
DATABASE_URL=

# ElevenLabs (voice agent wildcard)
ELEVENLABS_API_KEY=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# LLM Sidekick (streaming copilot chat). Set one key; the agent auto-picks
# Anthropic over Fireworks when both exist. Without a key, the copilot falls
# back to the scripted brain. Optional: SIDEKICK_LLM=anthropic|fireworks|off
# to force a provider, SIDEKICK_LLM_MODEL to override the default model
# (claude-haiku-4-5 / accounts/fireworks/models/kimi-k2p6).
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=
SIDEKICK_LLM=
SIDEKICK_LLM_MODEL=

# Live KICK webhooks (optional). Default broadcaster for
# `bun run scripts/kick-webhooks.ts create` — the channel's user_id.
KICK_BROADCASTER_USER_ID=

# Set to "off" to stop the chat engine self-starting the mock demo baseline
# in dev — required when receiving real webhooks at /api/webhook, or fake
# chat interleaves with live events.
CHAT_ENGINE_DEMO=
